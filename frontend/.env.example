# 复制为 frontend/.env 后按需修改；不要提交真实密钥
VITE_APP_TITLE='Frontend Template'
VITE_PORT=8848
VITE_OPEN=N
BROWSER=chrome
VITE_HTTP_PROXY=Y
VITE_PROXY_LOG=Y
VITE_STORAGE_PREFIX=RA_
VITE_DEVTOOLS_LAUNCH_EDITOR=code
VITE_AUTOMATICALLY_DETECT_UPDATE=Y
VITE_BASE_URL=./
VITE_ICON_PREFIX=icon
VITE_ICON_LOCAL_PREFIX=icon-local
VITE_ENABLE_TOKEN_REFRESH=Y
VITE_QWEATHER_PRIVATE_KEY=change_me
VITE_QWEATHER_SUB=change_me
