{
  "name": "electron-template",
  "version": "1.0.0",
  "private": true,
  "description": "Electron + Vue 3.5 + Vite+ 的桌面应用模板，主进程与渲染进程共享同一份类型化 IPC 契约。",
  "license": "UNLICENSED",
  "author": {
    "name": "woyuxiaji",
    "email": "woyuxiaji@foxmail.com"
  },
  "type": "module",
  "main": "dist-electron/main/index.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:renderer": "pnpm --filter @electron-template/frontend dev",
    "build": "pnpm run typecheck && pnpm run build:renderer && pnpm run build:electron",
    "build:renderer": "pnpm --filter @electron-template/frontend build",
    "build:electron": "node scripts/build-electron.mjs --production",
    "start": "pnpm run build && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --filter @electron-template/frontend typecheck",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "check": "vp check",
    "pack": "pnpm run build && electron-builder --dir",
    "dist:mac": "pnpm run build && electron-builder --mac",
    "dist:win": "pnpm run build && electron-builder --win",
    "dist:linux": "pnpm run build && electron-builder --linux",
    "prepare": "husky"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^24.10.1",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "typescript": "^5.9.3",
    "vite-plus": "^1.5.0"
  },
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@12.16.1"
}
