# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

echo "${BLUE}🔍 Running pre-commit checks...${NC}"

# Function to handle errors
handle_error() {
    echo "${RED}❌ Pre-commit check failed: $1${NC}"
    echo "${YELLOW}💡 Please fix the issues above and try committing again.${NC}"
    exit 1
}

# Check if we're in the right directory
if [ ! -d "frontend" ]; then
    handle_error "Frontend directory not found. Please run from project root."
fi

# Run TypeScript type checking
echo "${BLUE}📝 Running TypeScript type checking...${NC}"
if ! pnpm -C frontend typecheck; then
    handle_error "TypeScript type checking failed"
fi
echo "${GREEN}✅ TypeScript type checking passed${NC}"

# Run lint-staged for code formatting and linting
echo "${BLUE}🎨 Running code formatting and linting...${NC}"
if ! npm run lint:lint-staged; then
    handle_error "Code formatting or linting failed"
fi
echo "${GREEN}✅ Code formatting and linting passed${NC}"

echo "${GREEN}🎉 All pre-commit checks passed!${NC}"
