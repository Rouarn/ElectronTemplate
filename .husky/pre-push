#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

echo "${BLUE}🚀 Running pre-push checks...${NC}"

# Function to handle errors
handle_error() {
    echo "${RED}❌ Pre-push check failed: $1${NC}"
    echo "${YELLOW}💡 Please fix the issues above before pushing.${NC}"
    exit 1
}

# Check if we're in the right directory
if [ ! -d "frontend" ]; then
    handle_error "Frontend directory not found. Please run from project root."
fi

# Run full TypeScript type checking
echo "${BLUE}📝 Running comprehensive TypeScript checks...${NC}"
if ! (cd frontend && npm run typecheck); then
    handle_error "TypeScript type checking failed"
fi
echo "${GREEN}✅ TypeScript checks passed${NC}"

# Run ESLint on all files (not just staged)
echo "${BLUE}🔍 Running full ESLint check...${NC}"
if ! (cd frontend && npm run lint:eslint); then
    handle_error "ESLint check failed"
fi
echo "${GREEN}✅ ESLint check passed${NC}"

# Try to build the frontend to ensure it compiles
echo "${BLUE}🏗️  Testing frontend build...${NC}"
if ! (cd frontend && npm run build-only); then
    handle_error "Frontend build failed"
fi
echo "${GREEN}✅ Frontend build successful${NC}"

# Clean up build artifacts
echo "${BLUE}🧹 Cleaning up build artifacts...${NC}"
(cd frontend && rm -rf dist)

echo "${GREEN}🎉 All pre-push checks passed! Ready to push.${NC}"